{
  "name": "@zohelo/site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "react-router dev --port 3000 --host 0.0.0.0",
    "build": "bun run --cwd packages/design build && bun scripts/fetch-published.ts && react-router build && bun scripts/not-found.ts && bun scripts/sitemap.ts && bun scripts/rss.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "bun run --cwd packages/design build && react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@react-router/node": "7.18.5",
    "@zohelo/design": "workspace:*",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.5",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
