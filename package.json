{
  "name": "@zohelo/site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "react-router dev --port 3000 --host 0.0.0.0",
    "build": "bun run --cwd packages/design build && bun scripts/fetch-published.ts && react-router build && bun scripts/not-found.ts && bun scripts/sitemap.ts && bun scripts/rss.ts && bun scripts/calendar.ts && bun scripts/licence-check.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "bun run --cwd packages/design build && react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@react-router/node": "7.18.5",
    "@zohelo/design": "workspace:*",
    "gray-matter": "^4.0.3",
    "hyparquet": "^1.32.0",
    "hyparquet-compressors": "^1.1.3",
    "isbot": "^5",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.5",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@react-router/dev": "7.18.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "hyparquet-writer": "^0.18.0",
    "playwright": "1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
