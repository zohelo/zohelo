{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 300,
  "height": 100,
  "padding": {
    "left": 0,
    "right": 0,
    "top": 6,
    "bottom": 0
  },
  "data": {
    "values": [
      {
        "s": "Polska",
        "role": "accent",
        "t": "2023",
        "v": 37.64,
        "ill": false,
        "joint": false,
        "prelim": false,
        "last": false
      },
      {
        "s": "Polska",
        "role": "accent",
        "t": "2024",
        "v": 37.49,
        "ill": false,
        "joint": false,
        "prelim": false,
        "last": true
      }
    ]
  },
  "config": {
    "font": "Inter Variable, Plus Jakarta Sans, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter Variable, Plus Jakarta Sans, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#5D636B"
    }
  },
  "encoding": {
    "x": {
      "field": "t",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%Y",
        "tickCount": {
          "interval": "year",
          "step": 1
        },
        "tickColor": "#D9DEE3",
        "domainColor": "#D9DEE3",
        "grid": false,
        "labelFlush": true
      }
    },
    "y": {
      "field": "v",
      "type": "quantitative",
      "title": null,
      "scale": {
        "zero": true,
        "nice": true
      },
      "axis": {
        "format": ".2f",
        "orient": "right",
        "gridColor": "#E8ECEF",
        "gridDash": [
          1,
          3
        ],
        "domain": false,
        "ticks": false,
        "tickCount": 3,
        "labelPadding": 4,
        "labelExpr": "datum.label + ' mln'"
      }
    },
    "color": {
      "field": "role",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "accent"
        ],
        "range": [
          "#2C6E76"
        ]
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.ill || datum.joint"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 1.25,
        "strokeDash": [
          2,
          3
        ],
        "opacity": 0.7
      },
      "encoding": {
        "detail": {
          "field": "s"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "!datum.ill"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2
      },
      "encoding": {
        "detail": {
          "field": "s"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.last"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 34,
        "strokeWidth": 1.5
      },
      "encoding": {
        "fill": {
          "condition": {
            "test": "datum.prelim",
            "value": "white"
          },
          "field": "role",
          "type": "nominal",
          "scale": {
            "domain": [
              "accent"
            ],
            "range": [
              "#2C6E76"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.last"
        },
        {
          "calculate": "format(datum.v, '.2f') + ' mln'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dy": -7,
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Inter Variable, Plus Jakarta Sans, sans-serif"
      },
      "encoding": {
        "text": {
          "field": "lab"
        },
        "color": {
          "condition": {
            "test": "datum.role === 'context'",
            "value": "#5D636B"
          },
          "value": "#24292E"
        }
      }
    }
  ]
}