      "$type": "color",
      "$value": "#F4F7F9",
      "$extensions": {
        "dark": "#111315"
      }
    },
    "surface": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$extensions": {
        "dark": "#181B1E"
      }
    },
    "surface-2": {
      "$type": "color",
      "$value": "#EDF1F4",
      "$extensions": {
        "dark": "#202428"
      }
    },
    "border": {
      "$type": "color",
      "$value": "#E2E8F0",
      "$extensions": {
        "dark": "#2A2F34"
      }
    },
    "grid": {
      "$type": "color",
      "$value": "#E8ECEF",
      "$extensions": {
        "dark": "#262A2F"
      }
    },
    "ok": {
      "$type": "color",
      "$value": "#15803D",
      "$extensions": {
        "dark": "#5FD39A"
      }
    },
    "warn": {
      "$type": "color",
      "$value": "#B45309",
      "$extensions": {
        "dark": "#F2C14E"
      }
    },
    "danger": {
      "$type": "color",
      "$value": "#B91C1C",
      "$extensions": {
        "dark": "#FF8A80"
      }
    },
    "focus": {
      "$type": "color",
      "$value": "#2B5480",
      "$extensions": {
        "dark": "#8FB4E8"
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Newsreader",
        "serif"
      ],
      "$extensions": {
        "weights": [
          600,
          700
        ]
      }
    },
    "ui": {
      "$type": "fontFamily",
      "$value": [
        "Plus Jakarta Sans",
        "sans-serif"
      ],
      "$extensions": {
        "weights": [
          400,
          500,
          600,
          700
        ]
      }
    },
    "data": {
      "$type": "fontFamily",
      "$value": [
        "Inter Variable",
        "sans-serif"
      ],
      "$extensions": {
        "fontVariantNumeric": "tabular-nums"
      }
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono",
        "monospace"
      ]
    }
  },
  "size": {
    "xs": {
      "$type": "dimension",
      "$value": "12px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "13px"
    },
    "base": {
      "$type": "dimension",
      "$value": "14px"
    },
    "body": {
      "$type": "dimension",
      "$value": "16px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "20px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "32px"
    },
    "display": {
      "$type": "dimension",
      "$value": "44px"
    }
  },
  "line-height": {
    "body": {
      "$type": "number",
      "$value": 1.5
    },
    "heading": {
      "$type": "number",
      "$value": 1.2
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    },
    "16": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "6px"
    },
    "md": {
      "$type": "dimension",
      "$value": "10px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "14px"
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": "0 4px 16px -2px rgba(15,23,42,0.04), 0 2px 6px -1px rgba(15,23,42,0.02)",
      "$extensions": {
        "dark": "none"
      }
    },
    "popover": {
      "$type": "shadow",
      "$value": "0 12px 32px -4px rgba(15,23,42,0.12)",
      "$extensions": {
        "dark": "none"
      }
    }
  },
  "layout": {
    "content-max": {
      "$type": "dimension",
      "$value": "1280px"
    },
    "gutter": {
      "phone": {
        "$type": "dimension",
        "$value": "16px"
      },
      "tablet": {
        "$type": "dimension",
        "$value": "24px"
      },
      "desktop": {
        "$type": "dimension",
        "$value": "32px"
      }
    }
  }
}
