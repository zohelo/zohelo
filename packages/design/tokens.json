{
  "color": {
    "brand": {
      "teal": {
        "$type": "color",
        "$value": "#3B8B94",
        "$extensions": {
          "dark": "#5FB3BC"
        }
      },
      "teal-strong": {
        "$type": "color",
        "$value": "#2C6E76",
        "$extensions": {
          "dark": "#7FC6CD"
        }
      },
      "teal-soft": {
        "$type": "color",
        "$value": "#EBF5F6",
        "$extensions": {
          "dark": "#163238"
        }
      },
      "azure": {
        "$type": "color",
        "$value": "#3A6FA4",
        "$extensions": {
          "dark": "#8FB4E8"
        }
      }
    },
    "text": {
      "$type": "color",
      "$value": "#24292E",
      "$extensions": {
        "dark": "#E8EAED"
      }
    },
    "text-muted": {
      "$type": "color",
      "$value": "#5D636B",
      "$extensions": {
